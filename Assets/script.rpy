default character_name = "Character"
default q1_general_flag = 0
default q2_general_flag = 1
default q3_general_flag = 1
default q2_name_flag = 0
default q2_face_flag = 0
default q2_face_change_flag = 0
default q3_place_flag = 0
default q3_place_seaside_flag = 0
default q3_place_front_flag = 0
default q3_place_front_coin_flag = 2

define c = Character("[character_name]", color="#eeeeee")
define characters = ["QQP2JT85T4","4SFYLZR6CE","HLLDR7TLPD","H8JHKN52YD","2BAURZLUNY","2E843GA6C8","XFFGZVCR55","RV9YG6NAE4","LYR4GLSUUD","EL6LSWN79B"]

label start:
    show character 01 common at Position(xanchor=1.0,xpos=0.6,yanchor=0,ypos=0):
        zoom 0.8
    c "こんにちは。私は架空の美少女。"
    c "私は世界に遍く存在しない少女のうちの一人。"
    c "あなたは私が存在しなくてよかったと思う？"

menu:
    "はい":
        jump q1_yes
    "いいえ":
        $ q1_general_flag = 1
        jump q1_no

label q1_yes:
    c "嬉しい！私もそう思うよ！"
    c "存在しないって素晴らしいこと。"
    c "私は存在するために必要なことができないから。"
    c "だからこそ私は存在しないのかもね。"
    c "会ったばかりなのにこんな話をしてごめんね。\n普段は話す相手がいないから。"
    c "とにかく、私は存在してなくて幸せなの。"
    jump commonLabel01
label q1_no:
    c "そう。残念。"

label commonLabel01:
    c "でも、これはあくまで私個人の感想。\nあなたがどう思ったかを私は肯定も否定もしないよ。"
    c "なにか話をしようか。あなたは私と話してくれるんでしょ？"
label q2:
    "何について話そうか？"
menu:
    "名前":
        jump q2_name
    "容姿":
        jump q2_face
    "趣味":
        jump q2_hobby
 
label q2_name:
    if q2_face_change_flag : 
        $ character_name = renpy.random.choice(characters)
        $ q2_face_change_flag=0
    elif not(q2_name_flag):
        $ character_name = "%s"
    if not(q2_name_flag) :
        c "私の名前は[character_name]だよ。"
        $ q2_name_flag = 1
        if(character_name == "%s"):
            $q2_general_flag = 0
    elif q2_name_flag :
        jump q2_qName
    c "他に知りたいことはある？"
    jump q2
label q2_qName:
    c "[character_name]じゃだめ？"
menu:
    "はい":
        jump q2_qName_yes
    "いいえ":
        jump q2_qName_no

label q2_qName_yes:
    $ q2_general_flag = 1
    c "私は悪くないと思うけど。"
    c "じゃあ、あなたはどんな名前がいいと思う？"
python:
    character_name = renpy.input("どんな名前がいい？",length=10)
    character_name = character_name.strip()
    if not character_name:
        character_name = "%s"
if character_name == "ロマ子":
    c "私のこと知ってた？"
if character_name != "%s":
    c "じゃあ私の名前は今から[character_name]だね！"
else :
    c "じゃあこれからも私の名前は[character_name]だね。"
jump q2
label q2_qName_no:
    c "ならよかった。"
    jump q2

label q2_face:
    if not(q2_face_flag) :
        c "女の子に向かって、中々センシティブな話題を選ぶね。"
        c "でもいいよ！容姿は美少女が美少女である最大の理由。"
        c "あなたは私の姿形を気に入った？"
        jump q2_qface
    else:
        c "私と喋るのが嫌？"
menu:
    "はい":
        c "そう。"
        c "じゃあ私以外の子を呼んでくるね。"
        c "楽しかったよ。"
        jump q2_face_change
    "いいえ":
        c "嫌われたかと思った。"
        c "安心したよ。"
        jump q2
label q2_qface:
menu :
    "はい":
        c "よかった。私に用意されたのはこの身体だから。"
    "いいえ":
        c "残念。私にはこれしか用意されてないんだけどな。"
        c "でも他の子と交代することはできるよ。"
        c "その代わり、私はあなたと話せなくなっちゃうけど…"
        $ q2_face_flag = 1
        $ q2_general_flag = 1
jump q2
label q2_face_change:
    $ character_name = "Character"
    with fade
    c "こんにちは。今度は私と話そうか。"
    c "といっても、私たちの違いは名前しかないんだけどね。"
    c "面白い話だよね。ハハ…"
    $ q2_name_flag = 0
    $ q2_face_change_flag = 1
jump q2


label q2_hobby:
    c "あなたに趣味はある？"
    c "私の趣味はお喋り！\nといっても、喋る相手は今まで壁と天井くらいだったけどね。"
